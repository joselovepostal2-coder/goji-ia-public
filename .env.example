# Copia estos nombres en Render > Environment.
# No publiques un archivo .env real ni pegues claves en GitHub.
GOJI_ACCESS_CODE=CAMBIA_ESTO_POR_UN_CODIGO_LARGO_Y_PRIVADO
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Opcional: URL pública exacta del frontend si está alojado en otro dominio.
ALLOWED_ORIGIN=
# Modelos opcionales:
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat
